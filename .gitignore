# =============================================================================
# Warehouse Operations System — single root .gitignore
# =============================================================================

# -----------------------------------------------------------------------------
# Secrets
# -----------------------------------------------------------------------------
.env
.env.*
!.env.example
**/API KEY.txt
**/api_key*.txt
**/api-key*.txt
config/ShipStation/.env
!config/**/.env.example
!config/**/README.md
!config/README.md
!config/ShipStation/README.md
!Purchase Order Generator/config_example.py

# -----------------------------------------------------------------------------
# Python / tooling
# -----------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/
dist/
build/

# -----------------------------------------------------------------------------
# OS / editor
# -----------------------------------------------------------------------------
.DS_Store
Thumbs.db
Desktop.ini
*.swp
*~
.vscode/
*.code-workspace

# -----------------------------------------------------------------------------
# database/  (live DB files — machine-local; shareable exceptions below)
# -----------------------------------------------------------------------------
database/**
!database/README.md
!database/**/
!database/**/README.md
!database/order-grouping-sorter/taxonomy_picklists.csv
!database/order-packing-list-generator/Back Print.jpg
!database/production-design-queue-manager/Color Bar.png
database/order-grouping-sorter/catalog_cache/

# -----------------------------------------------------------------------------
# Logs/  (warehouse-root run logs — all contents ignored)
# -----------------------------------------------------------------------------
Logs/

# -----------------------------------------------------------------------------
# Output/  (warehouse-root run outputs — README.md only tracked)
# -----------------------------------------------------------------------------
Output/**
!Output/README.md
!Output/**/
!Output/**/README.md

# -----------------------------------------------------------------------------
# runtime/  (SharedInbox — README.md only tracked)
# -----------------------------------------------------------------------------
runtime/**
!runtime/README.md
!runtime/**/
!runtime/**/README.md

# -----------------------------------------------------------------------------
# scripts/  (shared caches)
# -----------------------------------------------------------------------------
scripts/_cache/

# -----------------------------------------------------------------------------
# Order Packing List Generator/
# Track README.md only under operator I/O folders. Missing Input/ stays tracked.
# -----------------------------------------------------------------------------
Order Packing List Generator/Input/*
!Order Packing List Generator/Input/README.md
Order Packing List Generator/Missing Logos/*
!Order Packing List Generator/Missing Logos/README.md
Order Packing List Generator/Missing Apparels/*
!Order Packing List Generator/Missing Apparels/README.md
Order Packing List Generator/Preflight Issues/*
!Order Packing List Generator/Preflight Issues/README.md
Order Packing List Generator/Unmatched SKUs/*
!Order Packing List Generator/Unmatched SKUs/README.md

# -----------------------------------------------------------------------------
# Production Design Queue Manager/
# -----------------------------------------------------------------------------
Production Design Queue Manager/Input/
Production Design Queue Manager/Missing Print Sizes/*
!Production Design Queue Manager/Missing Print Sizes/README.md

# -----------------------------------------------------------------------------
# Shipping Label Generator/
# -----------------------------------------------------------------------------
Shipping Label Generator/DTF Des Files/
Shipping Label Generator/DTF Des Files - Processed/
Shipping Label Generator/DTF Des Files -Processed/
Shipping Label Generator/**/*.log

# -----------------------------------------------------------------------------
# Order Grouping Sorter/
# -----------------------------------------------------------------------------
Order Grouping Sorter/scripts/_tmp_*/

# -----------------------------------------------------------------------------
# backups/  Versions/  archives
# -----------------------------------------------------------------------------
backups/*
!backups/README.md
!backups/docs/
**/Versions/
*.zip
*.7z
*.rar
*.tmp
~$*
*.log

# -----------------------------------------------------------------------------
# Cursor / local debug dumps
# -----------------------------------------------------------------------------
**/.cursor/debug*.log
/debug-*.log
**/debug-*.log
