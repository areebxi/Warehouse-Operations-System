# IMPORTANT:
# - .env is listed in .gitignore — it will NEVER be committed
# - Never share .env or put real keys in any other file
# - Rotate keys immediately if accidentally exposed

SHIPPING_PROVIDER=real

# ShipStation API (do not commit real keys)
REAL_API_BASE_URL=https://ssapi.shipstation.com
REAL_API_KEY=
REAL_API_SECRET=

# Optional overrides (leave blank to use shipping_config.yaml defaults)
MAX_CONCURRENCY=
SHIP_FROM=
PROCESSED_BY=
